# Copy to .env and adjust. All values are optional.
NAS_BACKUP_ROOT=/backup
NAS_DATA_DIR=./data
# Comma-separated log files the Logs page may tail (must be readable by the service user)
NAS_LOG_FILES=/var/log/samba/log.smbd,/var/log/samba/log.nmbd
# Set to true when served over HTTPS (reverse proxy) so the session cookie is Secure
NAS_COOKIE_SECURE=false
NAS_SESSION_HOURS=8
# Seconds between background scans of the backup tree (device discovery + backup log events)
NAS_SCAN_INTERVAL=300
# Optional executable called as: <hook> revoke|restore <device_slug>  (e.g. to disable a Samba user)
NAS_DEVICE_HOOK=
# User-portal uploads: max size per file (MB) and free space to always keep on the disk (MB)
NAS_MAX_UPLOAD_MB=2048
NAS_MIN_FREE_MB=1024
