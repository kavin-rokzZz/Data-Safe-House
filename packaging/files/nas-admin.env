# NAS Admin configuration. Restart after editing: sudo systemctl restart nas-admin
# Where backups live (a mounted disk, e.g. /mnt/nas). Must be writable by group "nas".
NAS_BACKUP_ROOT=/srv/nas
NAS_DATA_DIR=/var/lib/nas-admin
NAS_LOG_FILES=/var/log/samba/log.smbd,/var/log/samba/log.nmbd
# Set to true when served over HTTPS (reverse proxy)
NAS_COOKIE_SECURE=false
NAS_SESSION_HOURS=8
NAS_SCAN_INTERVAL=300
NAS_DEVICE_HOOK=
NAS_MAX_UPLOAD_MB=2048
NAS_MIN_FREE_MB=1024
